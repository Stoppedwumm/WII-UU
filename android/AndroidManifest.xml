<?xml version="1.0" encoding="utf-8"?>
<!-- WII-UU for Android handhelds: the menu and Choccy Milk (built by build-android.sh, no Gradle). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="wiiuu.android"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- cores come from libretro's buildbot -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- a WiiUU folder in the main storage, to copy games into over USB -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true"
        android:isGame="true"
        android:allowBackup="false">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- its own process: a crashing core only ends the game, and each game gets a fresh core -->
        <activity
            android:name=".GameActivity"
            android:label="@string/game_name"
            android:exported="false"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode" />
    </application>
</manifest>
